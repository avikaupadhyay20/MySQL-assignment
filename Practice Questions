-- 1
SELECT UPPER(CONCAT(FirstName, ' ', LastName)) AS FullName_Upper
 FROM CourseEnrollments;
 
-- 2
SELECT CONCAT(UPPER(SUBSTRING(FirstName, 1, 1)), SUBSTRING(FirstName, 2), ' ', LastName) AS FullName 
FROM CourseEnrollments;

-- 3
SELECT CONCAT(UPPER(LEFT(CourseName, 3)), '-', StudentID) AS StudentCode 
FROM CourseEnrollments;

-- 4
SELECT FirstName, REVERSE(FirstName) AS ReversedName,
 CHAR_LENGTH(FirstName) AS NameLength
 FROM CourseEnrollments;
 
-- 5
SELECT FirstName, LOCATE('a', FirstName) AS Position_of_a 
FROM CourseEnrollments;

-- 6
SELECT UPPER(REPLACE(FirstName, 'a', 'o')) AS ModifiedName
 FROM CourseEnrollments;
 
-- 7
SELECT LPAD(FirstName, 12, '0') AS PaddedName
 FROM CourseEnrollments;
 
-- 8
SELECT CONCAT(RIGHT(CourseName, 2), '-', LEFT(FirstName, 2)) AS CourseLabel
 FROM CourseEnrollments;
 
 
-- 9
SELECT CONCAT(UPPER(SUBSTRING(FirstName, 1, 3)), LOWER(RIGHT(LastName, 2))) AS Code
 FROM CourseEnrollments;
 
-- 10
SELECT Fee, ROUND(Fee, 1) AS Fee_1_Decimal, ROUND(Fee, 0) AS Fee_Whole
 FROM CourseEnrollments;
 
-- 11
SELECT Fee, CEIL(Fee) AS Fee_Ceil, FLOOR(Fee) AS Fee_Floor
 FROM CourseEnrollments;
 
-- 12
SELECT Fee, MOD(Fee, 500) AS Remainder_500 
FROM CourseEnrollments;

-- 13
SELECT Fee, ABS(Fee - 10000) AS Abs_Difference 
FROM CourseEnrollments;

-- 14
SELECT Fee, ROUND(Fee * 1.18, 2) AS Fee_With_GST 
FROM CourseEnrollments;

-- 15
SELECT Fee, FORMAT(Fee, 2) AS Formatted_Fee 
FROM CourseEnrollments;

-- 16
SELECT YEAR(EnrollmentDate) AS Enroll_Year,
 MONTHNAME(EnrollmentDate) AS Enroll_Month,
 DAYNAME(EnrollmentDate) AS Enroll_Day
 FROM CourseEnrollments;
 
-- 17
SELECT DATE_FORMAT(EnrollmentDate, '%d/%m/%Y') AS Enroll_Date,
 DATE_FORMAT(CompletionDate, '%M %d, %Y') AS Completion_Date 
 FROM CourseEnrollments;
 
-- 18
SELECT EnrollmentDate, CompletionDate, TIMESTAMPDIFF(DAY, EnrollmentDate, CompletionDate) AS Days_Between 
FROM CourseEnrollments;

-- 19
SELECT EnrollmentDate, DATE_ADD(DATE_ADD(EnrollmentDate, INTERVAL 1 MONTH), INTERVAL 10 DAY) AS New_Date
 FROM CourseEnrollments;
 
 
-- 20
SELECT CompletionDate, DATE_ADD(CompletionDate, INTERVAL -7 DAY) AS Date_7_Days_Before
 FROM CourseEnrollments;
 
 
-- 21
SELECT EnrollmentDate, CompletionDate, TIMESTAMPDIFF(MONTH, EnrollmentDate, CompletionDate) AS Months_Between
 FROM CourseEnrollments;
 
 
-- 22
SELECT EnrollmentDate, DATE_ADD(DATE_ADD(DATE_ADD(EnrollmentDate, INTERVAL 1 YEAR), INTERVAL 2 MONTH), INTERVAL 5 DAY) AS Shifted_Date
 FROM CourseEnrollments;
 
 
-- 23
SELECT EnrollmentDate, DAYNAME(EnrollmentDate) AS Enroll_Weekday, CompletionDate, DAYNAME(CompletionDate) AS Completion_Weekday 
FROM CourseEnrollments;


-- 24
SELECT EnrollmentDate, TIMESTAMPDIFF(DAY, EnrollmentDate, CURDATE()) AS Days_Since_Enrollment 
FROM CourseEnrollments;

-- 25
SELECT CompletionDate, DATE_FORMAT(DATE_ADD(CompletionDate, INTERVAL 15 DAY), '%d/%m/%Y') AS Completion_Plus_15 
FROM CourseEnrollments;
